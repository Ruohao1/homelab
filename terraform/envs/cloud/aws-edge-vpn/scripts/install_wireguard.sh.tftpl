#!/bin/bash
set -eux

apt update
apt install -y wireguard nftables

# Enable forwarding
echo "net.ipv4.ip_forward=1" >> /etc/sysctl.conf
sysctl -p

# Generate keys if not present
mkdir -p /etc/wireguard
cd /etc/wireguard

if [ ! -f privatekey ]; then
  umask 077
  wg genkey | tee privatekey | wg pubkey > publickey
fi

SERVER_PRIV="$(cat privatekey)"

cat > /etc/wireguard/wg0.conf <<EOF
[Interface]
Address = ${wg_addr}
PrivateKey = $${SERVER_PRIV}
ListenPort = ${wg_port}

PostUp = nft add table ip wg-nat; \
         nft add chain ip wg-nat postrouting { type nat hook postrouting priority 100 \; }; \
         nft add rule ip wg-nat postrouting ip saddr ${wg_net} oifname "${wan_if}" masquerade

PostDown = nft delete table ip wg-nat
EOF

systemctl enable wg-quick@wg0
systemctl start wg-quick@wg0
